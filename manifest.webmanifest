{
 "name": "図面計測ツール",
 "short_name": "図面計測",
 "description": "PDF・画像の図面から距離・面積・壁面積を計測し、ボード割付図を作成",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#14171c",
 "theme_color": "#14171c",
 "lang": "ja",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "application/pdf": [
     ".pdf"
    ],
    "image/*": [
     ".png",
     ".jpg",
     ".jpeg"
    ]
   }
  }
 ]
}